{
  "manifest_version": 3,
  "name": "SnapToClipboard",
  "version": "1.0",
  "description": "Click toolbar button to select a region and copy it to clipboard.",
  "permissions": ["scripting", "tabs", "activeTab", "clipboardWrite", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_title": "SnapToClipboard",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "host_permissions": ["<all_urls>"]
}
